generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(254)
  displayName  String        @db.VarChar(100)
  passwordHash String
  role         Role          @default(CUSTOMER)
  active       Boolean       @default(true)
  sessions     Session[]
  staffProfile StaffProfile?

  @@unique([id, role])
}

model Session {
  tokenHash String    @id @db.Char(64)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model Service {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(120)
  description     String         @db.VarChar(1000)
  priceVnd        Int
  durationMinutes Int
  active          Boolean        @default(true)
  assignments     StaffService[]

  @@index([active, name, id])
}

model StaffProfile {
  userId      String         @id @db.Uuid
  role        Role           @default(STAFF)
  user        User           @relation(fields: [userId, role], references: [id, role], onDelete: Restrict, onUpdate: Restrict)
  bio         String         @default("") @db.VarChar(1000)
  assignments StaffService[]

  workDays WorkDay[]
  daysOff  DayOff[]

  @@unique([userId, role])
}

model StaffService {
  staffId   String       @db.Uuid
  serviceId String       @db.Uuid
  staff     StaffProfile @relation(fields: [staffId], references: [userId], onDelete: Restrict)
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([staffId, serviceId])
  @@index([serviceId, staffId])
}

model WorkDay {
  staffId String       @db.Uuid
  weekday Int          @db.SmallInt
  staff   StaffProfile @relation(fields: [staffId], references: [userId], onDelete: Restrict)
  shifts  WorkShift[]

  @@id([staffId, weekday])
}

model WorkShift {
  id          String       @id @default(uuid()) @db.Uuid
  staffId     String       @db.Uuid
  weekday     Int          @db.SmallInt
  workDay     WorkDay      @relation(fields: [staffId, weekday], references: [staffId, weekday], onDelete: Cascade)
  startMinute Int          @db.SmallInt
  endMinute   Int          @db.SmallInt
  breaks      ShiftBreak[]

  @@unique([staffId, weekday, startMinute])
}

model ShiftBreak {
  shiftId     String    @db.Uuid
  shift       WorkShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  startMinute Int       @db.SmallInt
  endMinute   Int       @db.SmallInt

  @@id([shiftId, startMinute])
}

model DayOff {
  staffId String       @db.Uuid
  date    DateTime     @db.Date
  staff   StaffProfile @relation(fields: [staffId], references: [userId], onDelete: Restrict)

  @@id([staffId, date])
}
