generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique @db.VarChar(254)
  displayName       String             @db.VarChar(100)
  passwordHash      String
  role              Role               @default(CUSTOMER)
  active            Boolean            @default(true)
  appointments      Appointment[]
  appointmentEvents AppointmentEvent[]
  sessions          Session[]
  staffProfile      StaffProfile?

  @@unique([id, role])
}

model Session {
  tokenHash String    @id @db.Char(64)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model Service {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(120)
  description     String         @db.VarChar(1000)
  priceVnd        Int
  durationMinutes Int
  active          Boolean        @default(true)
  assignments     StaffService[]

  appointments Appointment[]

  @@index([active, name, id])
}

model StaffProfile {
  userId      String         @id @db.Uuid
  role        Role           @default(STAFF)
  user        User           @relation(fields: [userId, role], references: [id, role], onDelete: Restrict, onUpdate: Restrict)
  bio         String         @default("") @db.VarChar(1000)
  assignments StaffService[]

  appointments Appointment[]
  workDays     WorkDay[]
  daysOff      DayOff[]

  @@unique([userId, role])
}

model StaffService {
  staffId   String       @db.Uuid
  serviceId String       @db.Uuid
  staff     StaffProfile @relation(fields: [staffId], references: [userId], onDelete: Restrict)
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([staffId, serviceId])
  @@index([serviceId, staffId])
}

model WorkDay {
  staffId String       @db.Uuid
  weekday Int          @db.SmallInt
  staff   StaffProfile @relation(fields: [staffId], references: [userId], onDelete: Restrict)
  shifts  WorkShift[]

  @@id([staffId, weekday])
}

model WorkShift {
  id          String       @id @default(uuid()) @db.Uuid
  staffId     String       @db.Uuid
  weekday     Int          @db.SmallInt
  workDay     WorkDay      @relation(fields: [staffId, weekday], references: [staffId, weekday], onDelete: Cascade)
  startMinute Int          @db.SmallInt
  endMinute   Int          @db.SmallInt
  breaks      ShiftBreak[]

  @@unique([staffId, weekday, startMinute])
}

model ShiftBreak {
  shiftId     String    @db.Uuid
  shift       WorkShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  startMinute Int       @db.SmallInt
  endMinute   Int       @db.SmallInt

  @@id([shiftId, startMinute])
}

model DayOff {
  staffId String       @db.Uuid
  date    DateTime     @db.Date
  staff   StaffProfile @relation(fields: [staffId], references: [userId], onDelete: Restrict)

  @@id([staffId, date])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id              String             @id @default(uuid()) @db.Uuid
  customerId      String             @db.Uuid
  customer        User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staffId         String             @db.Uuid
  staff           StaffProfile       @relation(fields: [staffId], references: [userId], onDelete: Restrict)
  serviceId       String             @db.Uuid
  service         Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  startAt         DateTime           @db.Timestamptz(3)
  endAt           DateTime           @db.Timestamptz(3)
  serviceName     String             @db.VarChar(120)
  priceVnd        Int
  durationMinutes Int
  status          AppointmentStatus  @default(PENDING)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  events          AppointmentEvent[]

  @@index([staffId, startAt])
  @@index([customerId, startAt])
}

model AppointmentEvent {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId  String             @db.Uuid
  appointment    Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  actorId        String             @db.Uuid
  actor          User               @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason         String?            @db.VarChar(500)
  previousStatus AppointmentStatus?
  status         AppointmentStatus
  occurredAt     DateTime           @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  @@index([appointmentId, occurredAt])
}
