{
  "name": "@bookinghub/api",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "dev": "prisma generate && tsc-watch --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
    "typecheck": "prisma generate && tsc --noEmit",
    "build": "prisma generate && tsc",
    "test": "pnpm run build && node --env-file-if-exists=.env --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath test/health.test.cjs",
    "test:integration": "pnpm run build && node test/run-integration.cjs",
    "migrate": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate deploy",
    "seed": "pnpm run build && node --env-file-if-exists=.env dist/seed.js"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-express": "11.2.12",
    "@nestjs/swagger": "^11",
    "@nestjs/throttler": "^6.8.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "jest": "^30",
    "prisma": "7.10.1",
    "tsc-watch": "^7"
  }
}
