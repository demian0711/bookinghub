{
  "name": "@bookinghub/api",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "dev": "prisma generate && tsc-watch --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
    "typecheck": "prisma generate && tsc --noEmit",
    "build": "prisma generate && tsc",
    "test": "pnpm run build && node --env-file-if-exists=.env --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-express": "11.2.12",
    "@nestjs/swagger": "^11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "jest": "^30",
    "prisma": "7.10.1",
    "tsc-watch": "^7"
  }
}
